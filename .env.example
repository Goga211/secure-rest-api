# Скопируйте в .env и задайте свои значения. Файл .env в git не попадает.
DATABASE_URL=sqlite:///app.db

# Секрет для подписи JWT, не короче 32 символов. Сгенерировать:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Время жизни токена в минутах (1..1440)
JWT_TTL_MINUTES=15
